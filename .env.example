# ── 膳食健康助手 — 环境变量配置 ──
# 复制本文件为 .env 并填写实际值（.env 已被 gitignore，不会提交到仓库）

# ── DeepSeek API ──
# 必填，否则 /detect/deepseek、AI 周报等功能降级不可用
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的密钥在这里

# ── YOLO 模型 ──
# YOLO 模型路径（默认 models/food101/best.pt）
# YOLO_MODEL_PATH=models/food101/best.pt

# OOD Gate 门控开关（1 启用 / 0 关闭）
# 注意：Windows 上 embedding 提取可能异常导致误拒所有图片，如识别全失败可设为 0
FOOD_OOD_GATE_ENABLED=0

# 图像增强预处理（1 启用锐化+对比度增强 / 0 关闭）
FOOD_ENHANCE_IMAGE=1

# 最低置信度阈值（低于此值判定为"未能可靠识别"）
FOOD_CONFIDENCE_THRESHOLD=0.2

# ── 微信小程序登录 ──
# 必填，否则 wxlogin 无法换取 openid
# AppSecret 在微信公众平台 → 开发管理 → 开发设置 中获取
WX_APP_ID=你的appid
WX_APP_SECRET=你的appsecret

# ── 登录鉴权 ──
# token 有效期（天），过期后需重新登录小程序
# TOKEN_TTL_DAYS=30
